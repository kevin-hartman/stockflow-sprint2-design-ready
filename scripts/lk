#!/usr/bin/env bash
# lk , run a substrate/SCM or SFTDD CLI fast, without the npx tax.
#
# `npx --package=github:databricks-solutions/<pkg>#<ref> <bin>` re-resolves the
# GitHub ref on EVERY call (~3.5s even warm). This shim resolves a package ONCE
# per ref into a shared cache and runs the bin via `node dist/...` (~0.09s).
#
# Two packages back a scaffolded project, and lk routes each bin to its owner so
# each runs from its OWN dist (no cross-package node_modules paths):
#   lakebase-sftdd-* / lakebase-tdd-*  -> the SFTDD kit (its package name is
#                                         project config: $LAKEBASE_KIT_PACKAGE
#                                         or .lakebase/kit-package, written by the
#                                         kit's scaffolder; the substrate names it nowhere)
#   everything else                    -> the substrate (lakebase-scm-utils),
#                                         falling back to the kit for kit bins
#                                         that carry no sftdd-/tdd- prefix
#                                         (e.g. lakebase-resolve-sftdd-dir).
# Ownership is read from each package's own bin map, never a hardcoded list here.
# SCM-only projects only ever call substrate bins, so they only resolve the
# substrate; SFTDD projects resolve both.
#
# Ref resolution per package (so it works inside a `claude -p` agent's Bash tool,
# which does NOT reliably inherit env vars):
#   substrate: $LAKEBASE_SCM_UTILS_REF -> .lakebase/scm-utils-ref.local -> .lakebase/scm-utils-ref -> main
#   kit:       $LAKEBASE_KIT_REF        -> .lakebase/kit-ref.local        -> .lakebase/kit-ref        -> main
# The `*.local` files are GITIGNORED, so a branch checkout/reset never reverts
# them: the drive writes them at launch to pin the run's ref. The committed
# `*-ref` files stay authoritative for CI.
# Dev overrides: LAKEBASE_SCM_UTILS_DIR / LAKEBASE_KIT_DIR point directly at a
# package checkout/install.
set -euo pipefail

usage() { echo "usage: lk <bin> [args...]   (e.g. lk lakebase-scm-merge --help)" >&2; exit 2; }

first="${1:-}"
[ -z "$first" ] && usage

# Plain-language aliases for the toolkit install/refresh commands , "warm"/"rewarm"
# are insider jargon nobody recognizes. These normalize to the canonical flags so
# docs + humans can say the obvious word. Old flags still work (back-compat).
#   --install  / --download            -> --warm    (download the toolkit if needed)
#   --refresh  / --update / --reinstall -> --rewarm  (force a fresh re-download)
case "$first" in
  --install|--download) first="--warm" ;;
  --refresh|--update|--reinstall) first="--rewarm" ;;
esac

# Repo root: the ref + recovery hints are always read from the project.
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# --------------------------------------------------------------------------
# Resolve (and cache) one package. Sets global `pkg_dir` to its install dir.
# Args: SLUG (scm-utils|kit)  MODE (run|warm|rewarm)
# Returns 0 on success; 97 for a cold cache with LK_NO_INSTALL; nonzero on error.
# --------------------------------------------------------------------------
resolve_pkg() {
  local slug="$1" mode="$2"
  local pkg gh gh_url dir_override ref_env ref_local ref_file local_dir_file
  case "$slug" in
    scm-utils)
      pkg="@databricks-solutions/lakebase-scm-utils"
      dir_override="${LAKEBASE_SCM_UTILS_DIR:-}"
      ref_env="${LAKEBASE_SCM_UTILS_REF:-}"
      ref_local="$root/.lakebase/scm-utils-ref.local"; ref_file="$root/.lakebase/scm-utils-ref"
      local_dir_file="$root/.lakebase/scm-utils-local-dir" ;;
    kit)
      # The kit package name is project config, NOT hardcoded here (the substrate
      # must not name the extension): $LAKEBASE_KIT_PACKAGE or the committed
      # .lakebase/kit-package, which the kit's scaffolder writes.
      pkg="${LAKEBASE_KIT_PACKAGE:-}"
      [ -z "$pkg" ] && [ -f "$root/.lakebase/kit-package" ] && pkg="$(tr -d '[:space:]' < "$root/.lakebase/kit-package")"
      dir_override="${LAKEBASE_KIT_DIR:-}"
      ref_env="${LAKEBASE_KIT_REF:-}"
      ref_local="$root/.lakebase/kit-ref.local"; ref_file="$root/.lakebase/kit-ref"
      local_dir_file="$root/.lakebase/kit-local-dir" ;;
    *) echo "lk: internal error, unknown package slug '$slug'" >&2; return 1 ;;
  esac
  gh="github:databricks-solutions/${pkg##*/}"
  gh_url="https://github.com/databricks-solutions/${pkg##*/}.git"

  # Dev override: a checkout/install pointed at directly. warm/rewarm are no-ops.
  if [ -n "$dir_override" ]; then
    pkg_dir="$dir_override"
    return 0
  fi

  # Beyond the dir override, resolving a package needs its name. The kit's name is
  # project config; fail clearly if it is absent rather than build a broken
  # github:databricks-solutions/ URL from an empty package.
  if [ -z "$pkg" ]; then
    echo "lk: ${slug} package not configured; missing .lakebase/kit-package (run the scaffolder)" >&2
    return 1
  fi

  local ref="$ref_env"
  [ -z "$ref" ] && [ -f "$ref_local" ] && ref="$(tr -d '[:space:]' < "$ref_local")"
  [ -z "$ref" ] && [ -f "$ref_file" ] && ref="$(tr -d '[:space:]' < "$ref_file")"
  ref="${ref:-main}"

  local cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/${pkg##*/}"
  local cache="${cache_root}/${ref}"
  pkg_dir="${cache}/node_modules/${pkg}"

  local is_sha=0; case "$ref" in *[!0-9a-fA-F]* ) ;; * ) [ ${#ref} -eq 40 ] && is_sha=1 ;; esac
  remote_sha() { git ls-remote "$gh_url" "$ref" 2>/dev/null | awk 'NR==1{print $1}'; }

  # Completeness, not mere presence: verify EVERY package.json bin target exists
  # under the install, so a partial dist fails loud instead of silently at use.
  pkg_bins_complete() {
    node -e 'const fs=require("fs"),p=require("path"),r=process.argv[1];let b={};try{b=(require(r+"/package.json").bin)||{}}catch(e){process.stderr.write("lk: cannot read package.json at "+r+"\n");process.exit(1)}const m=Object.values(b).filter(x=>!fs.existsSync(p.join(r,x)));if(m.length){process.stderr.write("lk: "+r+" dist is INCOMPLETE , "+m.length+"/"+Object.keys(b).length+" bin(s) have no file (e.g. "+m.slice(0,3).join(", ")+").\n");process.exit(1)}' "$1"
  }

  install_pkg() {
    local committish="$1" sha="$2" tmp
    mkdir -p "$cache_root"
    tmp="$(mktemp -d "${cache_root}/.tmp.XXXXXX")"
    # Tell the consumer what is happening: this is a full npm install from git and
    # takes a couple minutes over the network the FIRST time a ref is cached (the
    # kit + its runtime deps). Without this, a silent multi-minute install looks
    # hung. `--omit=dev` skips the build-toolchain devDeps (tsup/vitest/typescript/
    # esbuild) , the kit ships prebuilt dist/, so consumers never build; `--no-audit
    # --no-fund` drop registry round-trips. npm's own progress goes to stderr (>&2)
    # so an interactive warm/rewarm narrates instead of going dark.
    echo "lk: Downloading the Consort toolkit (${pkg}@${committish}) , one-time for this version, ~1-2 min (kit + its dependencies). Later commands are instant." >&2
    # SHOW WHAT IS BEING INSTALLED , not just a clock. npm's progress bar is TTY-only
    # (silent when piped to a log for the relay), but `--loglevel=http` prints one line
    # per package fetched (`npm http fetch GET 200 …/<pkg>/-/<pkg>-<ver>.tgz`) , exactly
    # "what is being installed". We run npm to a temp log and FORWARD its new lines
    # (prefixed `lk:` so the narrator relays them) every few seconds as they land; only
    # when npm is briefly between fetches (e.g. the initial git clone) do we print an
    # elapsed-time line. So the relay never goes silent and never looks like a timeout.
    local npmlog; npmlog="$(mktemp)"
    npm install --loglevel=http --no-save --prefer-online --omit=dev --no-audit --no-fund --prefix "$tmp" "${gh}#${committish}" > "$npmlog" 2>&1 &
    local npm_pid=$! start last cur
    start=$(date +%s); last=0
    while kill -0 "$npm_pid" 2>/dev/null; do
      sleep 5
      cur=$(wc -c < "$npmlog" 2>/dev/null || echo 0)
      if [ "$cur" -gt "$last" ]; then
        tail -c "+$((last + 1))" "$npmlog" | sed 's/^/lk: /' >&2   # forward the real npm progress
        last="$cur"
      else
        echo "lk: … still installing the Consort TOOLKIT itself (the kit — one-time per version, cached + reused across projects) ($(( $(date +%s) - start ))s elapsed; ~1-2 min typical)…" >&2
      fi
    done
    # Flush any final lines npm wrote between the last poll and exit, then drop the log
    # (all branches below are covered , no leaked temp on success OR failure).
    cur=$(wc -c < "$npmlog" 2>/dev/null || echo 0)
    [ "$cur" -gt "$last" ] && tail -c "+$((last + 1))" "$npmlog" | sed 's/^/lk: /' >&2
    rm -f "$npmlog"
    if wait "$npm_pid" && [ -d "${tmp}/node_modules/${pkg}/dist" ]; then
      rm -rf "$cache"
      if mv "$tmp" "$cache" 2>/dev/null; then
        [ -n "$sha" ] && printf '%s\n' "$sha" > "${cache}/.pkg-sha" 2>/dev/null || true
        echo "lk: Consort toolkit ready (${pkg}@${committish}; subsequent commands are instant)." >&2
        return 0
      fi
      rm -rf "$tmp"; return 1
    fi
    rm -rf "$tmp"; return 1
  }

  if [ "$mode" = "rewarm" ]; then
    local sha; sha="$(remote_sha)"
    install_pkg "${sha:-$ref}" "$sha" || { echo "lk: --rewarm failed for ${slug} '${ref}'" >&2; return 1; }
    pkg_bins_complete "$pkg_dir" || { echo "lk: --rewarm installed an INCOMPLETE dist for ${slug} '${ref}' (cache: ${cache})" >&2; return 1; }
    return 0
  fi

  if [ "$mode" = "warm" ]; then
    local need_install=0
    { [ -d "${pkg_dir}/dist" ] && pkg_bins_complete "$pkg_dir" >/dev/null 2>&1; } || need_install=1
    if [ "$need_install" -eq 0 ] && [ "$is_sha" -eq 0 ]; then
      local cached_sha=""; [ -f "${cache}/.pkg-sha" ] && cached_sha="$(tr -d '[:space:]' < "${cache}/.pkg-sha")"
      local live_sha; live_sha="$(remote_sha)"
      [ -n "$live_sha" ] && [ "$live_sha" != "$cached_sha" ] && need_install=1
    fi
    if [ "$need_install" -eq 1 ]; then
      local sha; sha="$([ "$is_sha" -eq 1 ] && printf '%s' "$ref" || remote_sha)"
      install_pkg "${sha:-$ref}" "$sha" || true
    fi
    [ -d "${pkg_dir}/dist" ] || { echo "lk: could not warm ${slug} for ref '${ref}' (cache: ${cache})" >&2; return 1; }
    pkg_bins_complete "$pkg_dir" || { echo "lk: ${slug} for ref '${ref}' warmed but its dist is incomplete (cache: ${cache})" >&2; return 1; }
    return 0
  fi

  # mode=run: install once if the cache is cold (fast path, no network when warm).
  # Self-heal a lost cache for a LOCAL-ONLY ref FIRST: a ref recorded in
  # .lakebase/<slug>-local-dir exists only as a local symlink (never on GitHub),
  # so recover from the hint and skip the doomed network install. Re-plant the
  # symlink so later calls hit the fast cache path, and use it for this call.
  local local_dir=""
  [ -f "$local_dir_file" ] && local_dir="$(tr -d '[:space:]' < "$local_dir_file")"
  if [ ! -d "${pkg_dir}/dist" ] && [ -n "$local_dir" ] && [ -d "${local_dir}/dist" ]; then
    mkdir -p "$(dirname "$pkg_dir")" && rm -rf "$pkg_dir" && ln -s "$local_dir" "$pkg_dir" 2>/dev/null || true
    [ -d "${pkg_dir}/dist" ] || pkg_dir="$local_dir"
    echo "lk: cache for ${slug} ref '${ref}' was missing; recovered from ${local_dir_file##*/} (${local_dir})." >&2
  fi

  # LK_NO_INSTALL: latency-sensitive callers skip a cold-cache install and treat
  # exit 97 as "unavailable" (warming is the job of `lk --warm` at scaffold time).
  if [ ! -d "${pkg_dir}/dist" ]; then
    if [ -n "${LK_NO_INSTALL:-}" ]; then
      echo "lk: ${slug} cache cold for ref '${ref}' and LK_NO_INSTALL set , skipping install (run 'lk --warm')." >&2
      return 97
    fi
    local sha; sha="$([ "$is_sha" -eq 1 ] && printf '%s' "$ref" || remote_sha)"
    install_pkg "${sha:-$ref}" "$sha" || true
  fi
  [ -d "${pkg_dir}/dist" ] || { echo "lk: could not resolve ${slug} for ref '${ref}' (cache: ${cache})" >&2; return 1; }
  return 0
}

# Which package a bin PREFERS. The sftdd-/tdd- prefixed bins are unambiguously
# the kit's; every other bin resolves against the substrate first and falls back
# to the kit (below) when the substrate does not define it. That keeps kit bins
# without the prefix (e.g. lakebase-resolve-sftdd-dir, lakebase-adopt-sftdd)
# routing correctly WITHOUT hardcoding the kit's bin list here: ownership is read
# from each package's own package.json bin map.
pkg_for_bin() { case "$1" in lakebase-sftdd-*|lakebase-tdd-*) echo kit ;; *) echo scm-utils ;; esac; }

# True when this project actually uses the SFTDD kit: an explicit dir/ref
# override, a pinned kit-ref, or a scaffolded .sftdd/.tdd runtime dir. Gates both
# the --warm kit pass and the substrate->kit bin fallback, so a pure-substrate
# project never tries to resolve (and network-install) the kit for a typo'd bin.
project_uses_kit() {
  [ -n "${LAKEBASE_KIT_DIR:-}" ] || [ -n "${LAKEBASE_KIT_REF:-}" ] \
    || [ -f "$root/.lakebase/kit-ref.local" ] || [ -f "$root/.lakebase/kit-ref" ] \
    || [ -d "$root/.sftdd" ] || [ -d "$root/.tdd" ]
}

# Map bin -> dist path from a resolved package's own bin map; prints the relative
# path, or nothing when the package does not define the bin. Always exits 0 so a
# miss never trips `set -e` (the caller branches on an empty result instead).
bin_rel() { node -e 'const m=require(process.argv[1]+"/package.json").bin||{};const b=m[process.argv[2]];if(b)process.stdout.write(b)' "$1" "$2" 2>/dev/null || true; }

# --warm / --rewarm: prepare the caches. Always the substrate; the kit too when
# this project uses SFTDD (a kit ref is pinned or a .sftdd/ dir exists).
if [ "$first" = "--warm" ] || [ "$first" = "--rewarm" ]; then
  mode="${first#--}"
  # --detach (pass it AFTER --refresh/--install): re-launch this toolkit install in its
  # OWN session and return at once, so the ~1-2 min download NEVER hits the harness's
  # ~2min bash timeout and survives the turn ending. Its `lk:` progress lines (what is
  # being installed) stream to a log the caller relays POLL-ONCE with consort-watch
  # --since. macOS has no `setsid`, so node does the detach (spawn detached + unref).
  for _a in "$@"; do
    [ "$_a" = "--detach" ] || continue
    _log="$(mktemp "${TMPDIR:-/tmp}/consort-refresh.XXXXXX" 2>/dev/null || echo "/tmp/consort-refresh.$$")"
    _pid="$(LK_REFRESH_LOG="$_log" node -e 'const{spawn}=require("child_process"),fs=require("fs");const fd=fs.openSync(process.env.LK_REFRESH_LOG,"a");const c=spawn("bash",[process.argv[1],process.argv[2]],{detached:true,stdio:["ignore",fd,fd],env:process.env});c.unref();process.stdout.write(String(c.pid||""));' "$0" "$first" 2>/dev/null)"
    if [ -n "$_pid" ]; then
      echo "lk: toolkit install detached into its own session as pid ${_pid} (survives this turn + the ~2min bash timeout)." >&2
      echo "lk:   live log: ${_log}" >&2
      echo "lk:   relay it POLL-ONCE: consort-watch --since 0 --log \"${_log}\" --pid ${_pid}  (re-poll with the printed cursor until status=done)" >&2
      exit 0
    fi
    echo "lk: detach re-spawn failed , running the install in-process instead." >&2
    break
  done
  resolve_pkg scm-utils "$mode" || exit 1
  if project_uses_kit; then
    resolve_pkg kit "$mode" || exit 1
  fi
  exit 0
fi

bin="$first"; shift
# Deprecation: lakebase-sftdd-* / lakebase-tdd-* are legacy aliases from the
# pre-Consort skill names. They still run (routed to the kit below), but are
# scheduled for removal in consort v0.4.0 , prefer the consort-* / lakebase-*
# names. One notice per invocation; never blocks.
case "$bin" in
  lakebase-sftdd-*|lakebase-tdd-*)
    echo "lk: [deprecated] '${bin}' is a legacy sftdd/tdd-era alias; use the consort-* / lakebase-* name (removed in consort v0.4.0). Still running." >&2 ;;
esac
slug="$(pkg_for_bin "$bin")"
resolve_pkg "$slug" run; rc=$?
[ "$rc" -eq 97 ] && exit 97
[ "$rc" -ne 0 ] && exit "$rc"
rel="$(bin_rel "$pkg_dir" "$bin")"

# Substrate->kit fallback: a non-prefixed bin defaults to the substrate, but some
# kit bins carry no sftdd-/tdd- prefix. When the substrate does not define the bin
# and this project uses the kit, resolve it from the kit instead. sftdd-/tdd- bins
# route to the kit up front and never reach here, so an unknown kit bin still fails
# fast with no substrate round-trip.
if [ -z "$rel" ] && [ "$slug" = "scm-utils" ] && project_uses_kit; then
  resolve_pkg kit run; krc=$?
  [ "$krc" -eq 97 ] && exit 97
  if [ "$krc" -eq 0 ]; then
    rel="$(bin_rel "$pkg_dir" "$bin")"
    [ -n "$rel" ] && slug="kit"
  fi
fi

[ -z "$rel" ] && { echo "lk: unknown bin: ${bin}" >&2; exit 2; }
exec node "${pkg_dir}/${rel}" "$@"
